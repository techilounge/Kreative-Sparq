# The foundation builds without environment variables or production secrets.
# Set this to the verified public origin when configuring canonical metadata.
NEXT_PUBLIC_SITE_URL=https://kreativesparq.com

# Booking, forms, CMS, analytics, and email remain intentionally unconfigured in Phase 8.
# Their public routes use truthful static fallbacks. Add server-only credentials only after the
# destination/provider is approved and tested; never use NEXT_PUBLIC_ for secrets.
