# Kreative Sparq environment variables.
#
# Copy to .env.local for development, and set the same names in the Vercel
# project for preview and production.
#
# Two rules decide where a value belongs:
#
#   NEXT_PUBLIC_  is sent to the browser. Never put a secret here.
#   everything else stays on the server and is read only by server code.
#
# Every value below is optional. A feature that depends on an unset value is
# hidden rather than shown in a broken state: the inquiry forms do not render
# without somewhere to send an inquiry, the booking page does not render an
# empty frame, and the legal routes stay unpublished until their clauses are
# supplied. Nothing here is required to run the site locally.

# --- Site -------------------------------------------------------------------

# Canonical origin, with no trailing slash. Used for canonicals, the sitemap,
# Open Graph URLs, and structured data. Defaults to https://kreativesparq.com.
NEXT_PUBLIC_SITE_URL=

# --- Contact details --------------------------------------------------------
#
# Each of these appears in the header, footer, and contact page only once set.
# Leave a value blank rather than filling it with a placeholder: an address
# nobody monitors is worse than no address.

NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_URL=

# Free text, shown beside the contact details. Example: "Monday to Friday,
# 9am to 5pm WAT".
NEXT_PUBLIC_BUSINESS_HOURS=

# The reply window the business will actually honour. Example: "two business
# days". No reply time is promised anywhere until this is set.
NEXT_PUBLIC_RESPONSE_TIME=

# Pipe-separated profile URLs. These are published as `sameAs` in the
# organisation structured data, so only add profiles that are live and owned.
# Example: https://www.linkedin.com/company/example|https://instagram.com/example
NEXT_PUBLIC_SOCIAL_PROFILES=

# --- Project brief ----------------------------------------------------------

# Pipe-separated budget bands offered in the project brief. Bands are never
# invented: until this is set the only option is "Not decided yet".
# Example: Under ₦5m|₦5m to ₦15m|Above ₦15m
NEXT_PUBLIC_BUDGET_BANDS=

# --- Lead destination -------------------------------------------------------
#
# The contact form and the project brief render only when at least one of the
# two destinations below is configured. With neither, both pages show a state
# that says so and points at the booking route.

# Supabase project URL, for example https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Server-only key used to insert leads. This must be the secret (service role)
# key and must never be given a NEXT_PUBLIC_ name: the browser would then be
# able to read every lead in the table.
SUPABASE_SECRET_KEY=

# Resend API key, used for the visitor confirmation and the internal notice.
RESEND_API_KEY=

# Verified sender on the Resend account, for example hello@kreativesparq.com.
CONTACT_FROM_EMAIL=

# Monitored inbox that receives the internal notification.
CONTACT_TO_EMAIL=

# --- Spam controls ----------------------------------------------------------
#
# Cloudflare Turnstile. Both halves are needed: with only the site key the
# widget renders but no token is verified, so the challenge is skipped
# server-side and the submission is rejected.

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting ----------------------------------------------------------
#
# An Upstash Redis REST endpoint and token. Without these the limiter falls
# back to per-instance memory, which does not hold across serverless
# instances and is treated as non-durable.

RATE_LIMIT_PROVIDER_URL=
RATE_LIMIT_PROVIDER_TOKEN=

# --- Booking ----------------------------------------------------------------

# Cal.com link, for example kreativesparq/strategy-call. The booking page
# shows the approved alternative routes until this is set.
NEXT_PUBLIC_CAL_LINK=

# --- Newsletter -------------------------------------------------------------

# Subscription endpoint. The newsletter form is hidden entirely until this
# exists, so no address is ever collected with nowhere to store it.
NEWSLETTER_ENDPOINT=

# --- Content source ---------------------------------------------------------
#
# Optional. With both set, the content adapter can read from Sanity instead of
# the typed files in content/. See sanity/README.md.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# --- Legal ------------------------------------------------------------------
#
# The Privacy Policy and Terms of Use publish only when the entity details,
# every clause below, and the corresponding last-updated date are all present.
# Until then each route renders a short notice that the document is with
# counsel, and stays out of the sitemap and the index.
#
# These are clauses supplied by a qualified adviser. Do not draft them here.

NEXT_PUBLIC_LEGAL_BUSINESS_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=

LEGAL_PRIVACY_BASIS=
LEGAL_PRIVACY_RETENTION=
LEGAL_PRIVACY_PROVIDERS=
LEGAL_PRIVACY_COOKIES=

LEGAL_TERMS_GOVERNING_LAW=
LEGAL_TERMS_LIABILITY=
LEGAL_TERMS_INDEMNITY=

# Dates in ISO form, for example 2026-01-31.
NEXT_PUBLIC_PRIVACY_LAST_UPDATED=
NEXT_PUBLIC_TERMS_LAST_UPDATED=
