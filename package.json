{
  "name": "kreative-sparq",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:server": "next start -H 127.0.0.1 -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components content scripts tests eslint.config.mjs next.config.ts playwright.config.ts postcss.config.mjs package.json pnpm-workspace.yaml tsconfig.json README.md",
    "format:check": "prettier --check app components content scripts tests eslint.config.mjs next.config.ts playwright.config.ts postcss.config.mjs package.json pnpm-workspace.yaml tsconfig.json README.md",
    "copy:check": "node scripts/extract-services.mjs --check && node scripts/extract-editorial.mjs --check",
    "screenshots:services": "node scripts/capture-service-screenshots.mjs",
    "screenshots:editorial": "node scripts/capture-editorial-screenshots.mjs",
    "browser:install": "playwright install chromium",
    "test": "node scripts/run-browser-tests.mjs --project=chromium",
    "test:edge": "node scripts/run-browser-tests.mjs --project=edge"
  },
  "dependencies": {
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.5.0",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  }
}
